{
  "file.0000000000000001.title": "飞行任务记录",
  "chapter.1000000000000000.title": "0 · 落地",
  "quest.1000000000000100.title": "地表信号",
  "quest.1000000000000100.quest_desc": [
    "当前位于星球维度。体验预设从母星开始，未配发出生飞船。"
  ],
  "quest.1000000000000200.title": "木材储备",
  "quest.1000000000000200.quest_desc": [
    "等待木材样本。六个面构成连续星球，天空可见其他星球。"
  ],
  "quest.1000000000000300.title": "野外工作台",
  "quest.1000000000000300.quest_desc": [
    "等待组装台面。使用本地木材制作工作台。"
  ],
  "quest.1000000000000400.title": "开始开采",
  "quest.1000000000000400.quest_desc": [
    "等待开采工具。石料与安山岩用于建设第一间工坊。"
  ],
  "quest.1000000000000500.title": "石料储备",
  "quest.1000000000000500.quest_desc": [
    "石料储备待补充。先在出生区域附近开采，再扩大活动范围。"
  ],
  "quest.1000000000000600.title": "作业照明",
  "quest.1000000000000600.quest_desc": [
    "等待照明补给。标记住所与矿井之间的路线。"
  ],
  "chapter.1000000000010000.title": "1 · 地面生存",
  "quest.1000000000010100.title": "冶炼站",
  "quest.1000000000010100.quest_desc": [
    "等待热加工设备。在工作台附近安装熔炉。"
  ],
  "quest.1000000000010200.title": "固体燃料",
  "quest.1000000000010200.quest_desc": [
    "等待固体燃料。煤用于冶炼与野外照明。"
  ],
  "quest.1000000000010300.title": "铁料补给",
  "quest.1000000000010300.quest_desc": [
    "等待铁料样本。母星矿表包含铁、铜、煤、金、锌、红石，不含锇。"
  ],
  "quest.1000000000010400.title": "稳定开采",
  "quest.1000000000010400.quest_desc": [
    "等待铁制工具。后续控制部件需要红石与金。"
  ],
  "quest.1000000000010500.title": "铜材导体",
  "quest.1000000000010500.quest_desc": [
    "等待铜材储备。流体设备与电气连接将使用这批材料。"
  ],
  "quest.1000000000010600.title": "食物储备",
  "quest.1000000000010600.quest_desc": [
    "等待食物补给。长途飞行前建立可持续农田。"
  ],
  "quest.1000000000010700.title": "地表住所",
  "quest.1000000000010700.quest_desc": [
    "等待住所设备。在受保护的地面基地放置床。"
  ],
  "quest.1000000000010800.title": "野外防护",
  "quest.1000000000010800.quest_desc": [
    "等待盾牌。整合包未设置氧气与航天服进度。"
  ],
  "chapter.1000000000020000.title": "2 · 机械动力",
  "quest.1000000000020100.title": "安山合金",
  "quest.1000000000020100.quest_desc": [
    "等待合金补给。母星保留浅层安山岩矿斑。"
  ],
  "quest.1000000000020200.title": "旋转动力源",
  "quest.1000000000020200.quest_desc": [
    "等待机械动力源。利用水流驱动水车。"
  ],
  "quest.1000000000020300.title": "动力传输",
  "quest.1000000000020300.quest_desc": [
    "等待传动轴储备。将水车接入工坊，检查应力余量。"
  ],
  "quest.1000000000020400.title": "冲压生产线",
  "quest.1000000000020400.quest_desc": [
    "等待冲压设备。船件与燃料设备需要金属板。"
  ],
  "quest.1000000000020500.title": "铁板储备",
  "quest.1000000000020500.quest_desc": [
    "等待铁板储备。使用机械压力机加工铁锭。"
  ],
  "quest.1000000000020600.title": "搅拌容器",
  "quest.1000000000020600.quest_desc": [
    "等待搅拌容器。预留搅拌器与热源的安装空间。"
  ],
  "quest.1000000000020700.title": "搅拌动力",
  "quest.1000000000020700.quest_desc": [
    "等待搅拌设备。投产前通过 JEI 核对所需转速。"
  ],
  "quest.1000000000020800.title": "热源储备",
  "quest.1000000000020800.quest_desc": [
    "下界已移除。使用三块铁板、一块煤炭块和一块铜锭合成烈焰人燃烧室。玻璃周围放置八份红石粉可合成玫瑰石英，打磨后制作电子管。"
  ],
  "quest.1000000000020900.title": "稳定热源",
  "quest.1000000000020900.quest_desc": [
    "等待烈焰人燃烧室。暂定推进器配方也会消耗燃烧室。"
  ],
  "quest.1000000000020A00.title": "黄铜生产",
  "quest.1000000000020A00.quest_desc": [
    "等待黄铜储备。按配方加热混合铜与锌。"
  ],
  "quest.1000000000020B00.title": "控制电子元件",
  "quest.1000000000020B00.quest_desc": [
    "等待电子管。初始驾驶台与陀螺仪使用 Create 电子元件，不要求锇电路。"
  ],
  "quest.1000000000020C00.title": "精密装配",
  "quest.1000000000020C00.quest_desc": [
    "等待精密构件。制造推进设备前建立稳定生产流程。"
  ],
  "chapter.1000000000030000.title": "3 · 低空飞行",
  "quest.1000000000030100.title": "飞行器结构",
  "quest.1000000000030100.quest_desc": [
    "等待飞行器机身。低空探索与入轨飞船采用不同设备路线。"
  ],
  "quest.1000000000030200.title": "飞行器发动机",
  "quest.1000000000030200.quest_desc": [
    "等待飞行器发动机。通过 JEI 核对飞行器燃料要求。"
  ],
  "quest.1000000000030300.title": "飞行器螺旋桨",
  "quest.1000000000030300.quest_desc": [
    "等待螺旋桨。清理起飞与降落区域。"
  ],
  "quest.1000000000030400.title": "侦察飞机",
  "quest.1000000000030400.quest_desc": [
    "侦察机准备就绪。保持安全高度尝试跨面飞行；物品任务不验证实际飞行。"
  ],
  "quest.1000000000030500.title": "浮力结构",
  "quest.1000000000030500.quest_desc": [
    "等待气囊储备。Aeronautics 提供另一条低空载具路线。"
  ],
  "quest.1000000000030600.title": "物理结构组装",
  "quest.1000000000030600.quest_desc": [
    "等待物理结构组装器。建造入轨船体前确认安装方向与组装操作。"
  ],
  "quest.1000000000030700.title": "结构连接",
  "quest.1000000000030700.quest_desc": [
    "等待强力胶。连接预定船体方块，避免将起飞平台粘入结构。"
  ],
  "quest.1000000000030800.title": "地表勘察组件",
  "quest.1000000000030800.quest_desc": [
    "勘察推进组件已获取。观察面边界，远离不稳定折点。当前未提供折点自动检测任务。"
  ],
  "chapter.1000000000040000.title": "4 · 燃料与入轨",
  "quest.1000000000040100.title": "油田勘探",
  "quest.1000000000040100.quest_desc": [
    "等待油田探测器。自定义星球生成器中的油田可用性仍需实测。"
  ],
  "quest.1000000000040200.title": "抽油动力",
  "quest.1000000000040200.quest_desc": [
    "等待抽油机轴承。按模组说明搭建完整抽油结构。"
  ],
  "quest.1000000000040300.title": "燃料加工",
  "quest.1000000000040300.quest_desc": [
    "等待流体储罐与蒸馏控制器。将已放置的 Create 储罐转换为蒸馏塔；蒸馏罐方块没有独立背包物品。接入热源后生产第一级柴油或汽油。"
  ],
  "quest.1000000000040400.title": "首批燃料",
  "quest.1000000000040400.quest_desc": [
    "等待柴油样本。推进器也接受汽油。初始入轨预算目标约八桶，仍需实测调整。"
  ],
  "quest.1000000000040500.title": "船载储罐",
  "quest.1000000000040500.quest_desc": [
    "等待流体储罐。储罐与推进器必须属于同一组装船体，保留返航燃料。"
  ],
  "quest.1000000000040600.title": "推力设备",
  "quest.1000000000040600.quest_desc": [
    "推进器已获取。合并燃料系统后，无燃料则无推力。推力与船体质量决定爬升表现。"
  ],
  "quest.1000000000040700.title": "姿态控制",
  "quest.1000000000040700.quest_desc": [
    "陀螺仪已获取。安装至组装船体；陀螺仪不消耗推进燃料。"
  ],
  "quest.1000000000040800.title": "驾驶控制台",
  "quest.1000000000040800.quest_desc": [
    "驾驶台已获取。起飞前检查船体连接、离地间隙与反向推进。"
  ],
  "quest.1000000000040900.title": "目视仪表",
  "quest.1000000000040900.quest_desc": [
    "基础观察镜已获取。首航前使用精密构件、电子管与两块黄铜板升级为导航观察镜。"
  ],
  "quest.1000000000050800.title": "导航光学",
  "quest.1000000000050800.quest_desc": [
    "导航观察镜通过 Create 路线制造，无须锇。首次起飞前检查目标锁定与相对接近速度。"
  ],
  "quest.1000000000040A00.title": "离地记录",
  "quest.1000000000040A00.quest_desc": [
    "等待离地进度记录。先完成可控爬升，再继续入轨。"
  ],
  "quest.1000000000040B00.title": "太空区域记录",
  "quest.1000000000040B00.quest_desc": [
    "等待进入太空的进度记录。完成后状态：当前位于太空区域。保持驾驶，监测燃料。"
  ],
  "quest.1000000000040C00.title": "登船路线",
  "quest.1000000000040C00.quest_desc": [
    "登船梯已获取。在母星演练着陆与登船。现有母星返航进度仅认证后续外星往返，不认证本次演练。"
  ],
  "chapter.1000000000050000.title": "5 · 第一次跨星：锇",
  "quest.1000000000050100.title": "外星着陆",
  "quest.1000000000050100.quest_desc": [
    "等待外星着陆进度记录。岩质星球与小行星提供锇及深层稀有钻石；钻石位于可挖深度底部35%，丰度为待调初猜。这些星球仍在当前恒星系内。"
  ],
  "quest.1000000000050200.title": "锇矿货物",
  "quest.1000000000050200.quest_desc": [
    "等待锇矿样本。为电路与返航物流预留部分货物。"
  ],
  "quest.1000000000050300.title": "精炼锇材",
  "quest.1000000000050300.quest_desc": [
    "等待锇锭。取得外星供料后启动 Mekanism 工业线。"
  ],
  "quest.1000000000050400.title": "母星着陆记录",
  "quest.1000000000050400.quest_desc": [
    "等待外星往返进度记录。取得外星着陆与再次入太空记录后，返回母星着陆。"
  ],
  "quest.1000000000050500.title": "机械能转电能",
  "quest.1000000000050500.quest_desc": [
    "等待交流发电机。将 Create 旋转动力接入电气生产线。"
  ],
  "quest.1000000000050600.title": "电路加工",
  "quest.1000000000050600.quest_desc": [
    "等待冶金灌注机。接入电力并提供配方所需灌注材料。"
  ],
  "quest.1000000000050700.title": "基础控制电路",
  "quest.1000000000050700.quest_desc": [
    "等待基础控制电路。锇用于启动 Mekanism 加工，并进一步制作精密观察镜所需的高级电路。"
  ],
  "quest.1000000000050900.title": "氢气生产",
  "quest.1000000000050900.quest_desc": [
    "等待电解分离器。供应水与电力；化学形态氢不能直接作为推进器流体。"
  ],
  "quest.1000000000050A00.title": "流体转换",
  "quest.1000000000050A00.quest_desc": [
    "等待旋转冷凝器。先将氢转为流体形态，再向船载储罐加注。"
  ],
  "quest.1000000000050B00.title": "第二级燃料样本",
  "quest.1000000000050B00.quest_desc": [
    "等待液氢样本。参考船入轨目标约三桶，仅为待调初值，未经过实测。"
  ],
  "chapter.1000000000060000.title": "6 · 星系扩张",
  "quest.1000000000060100.title": "冰冻星锡矿",
  "quest.1000000000060100.quest_desc": [
    "等待锡矿货物。冰冻类星球矿表提供锡与铅。"
  ],
  "quest.1000000000060200.title": "冰冻星铅矿",
  "quest.1000000000060200.quest_desc": [
    "等待铅矿货物。建立运输路线，避免只依赖单次小规模采集。"
  ],
  "quest.1000000000060300.title": "晶体星萤石",
  "quest.1000000000060300.quest_desc": [
    "等待萤石样本。晶体类星球还提供石英、紫水晶及更少量深层钻石（可挖深度底部35%，丰度为待调初猜）。"
  ],
  "quest.1000000000060400.title": "高级控制电路",
  "quest.1000000000060400.quest_desc": [
    "等待高级控制电路。为精密光学准备电子元件。"
  ],
  "quest.1000000000060500.title": "精密光学",
  "quest.1000000000060500.quest_desc": [
    "精密观察镜已获取。该配方升级光学设备。离开母恒星系需要星际引擎和氘；boss 许可尚未强制。"
  ],
  "quest.1000000000060600.title": "干旱星铀矿",
  "quest.1000000000060600.quest_desc": [
    "等待铀矿货物。干旱类星球矿表提供铀与金；建设反应堆前规划屏蔽与加工。"
  ],
  "quest.1000000000060700.title": "火山星残骸",
  "quest.1000000000060700.quest_desc": [
    "等待远古残骸。火山类星球矿表包含残骸、金与石英；开采时避开岩浆。"
  ],
  "quest.1000000000060800.title": "耐热材料储备",
  "quest.1000000000060800.quest_desc": [
    "等待下界合金碎片。该材料不构成抗压船体认证。"
  ],
  "quest.1000000000060900.title": "流体货运能力",
  "quest.1000000000060900.quest_desc": [
    "等待高级流体储罐。核对 Mekanism 储罐与船载储罐之间的流体输送。"
  ],
  "quest.1000000000060A00.title": "前哨维护",
  "quest.1000000000060A00.quest_desc": [
    "钢制多用工具已获取。为已建立的前哨补充工具与维修材料。"
  ],
  "quest.1000000000060B00.title": "制作铝合金外壳板",
  "quest.1000000000060B00.quest_desc": [
    "等待轻质面板。采集沙漠类星球的铝土矿，冶炼后使用八块铝锭制造四块板材。完整方块质量0.5，默认耐压0.5，数值暂定。"
  ],
  "chapter.1000000000070000.title": "7 · 异常星球与 boss",
  "quest.1000000000070100.title": "战斗防护",
  "quest.1000000000070100.quest_desc": [
    "等待护甲。接近异常地形前确认安全撤离路线。"
  ],
  "quest.1000000000070200.title": "远程作战能力",
  "quest.1000000000070200.quest_desc": [
    "等待远程武器。战斗时远离不稳定折点地形。"
  ],
  "quest.1000000000070300.title": "弹药储备",
  "quest.1000000000070300.quest_desc": [
    "等待弹药补给。补给数量为待实测调整的初值。"
  ],
  "quest.1000000000070400.title": "恢复补给",
  "quest.1000000000070400.quest_desc": [
    "等待恢复补给。血肉勘测需要补给，以及通往巢穴巨坑外的撤离路线。"
  ],
  "quest.1000000000070800.title": "抵达血肉",
  "quest.1000000000070800.quest_desc": [
    "手动勘测记录：定位 Amber 最外侧卫星血肉，确认着陆后登记。勾选不自动检测所在星球。"
  ],
  "quest.1000000000070900.title": "进入巢穴巨坑",
  "quest.1000000000070900.quest_desc": [
    "手动勘测记录：沿巢脊进入巨坑后登记。接近宿主前记录撤离路线。勾选不自动检测进入。"
  ],
  "quest.1000000000070A00.title": "击败宿主",
  "quest.1000000000070A00.quest_desc": [
    "等待战斗记录：在巢穴巨坑击败宿主。遭遇掉落四个宿主神经节，为机械线星际引擎提供必需的生物部件。"
  ],
  "quest.1000000000070B00.title": "获得宿主神经节",
  "quest.1000000000070B00.quest_desc": [
    "等待神经节样本。保留一个用于机械合成星际引擎，其余样本可供后续引擎制造。用量暂定。"
  ],
  "chapter.1000000000080000.title": "8 · 气态巨行星与星际航行",
  "quest.1000000000080100.title": "船体材料储备",
  "quest.1000000000080100.quest_desc": [
    "等待船载设备钢材。耐压值按方块计算，不是整舰护盾。"
  ],
  "quest.1000000000080200.title": "结构材料储备",
  "quest.1000000000080200.quest_desc": [
    "等待结构材料补给。普通铁块仍从压力0.5开始损坏；深层采集前将暴露结构换为耐压壳。"
  ],
  "quest.1000000000080300.title": "远程控制组件",
  "quest.1000000000080300.quest_desc": [
    "等待精英控制电路。掠取氘后，为星际引擎预留四块精英电路。"
  ],
  "quest.1000000000080400.title": "大容量储存",
  "quest.1000000000080400.quest_desc": [
    "等待储存设备。依赖该储罐飞行前，验证船载燃料抽取支持情况。"
  ],
  "quest.1000000000080900.title": "制作锇合金耐压壳",
  "quest.1000000000080900.quest_desc": [
    "采气前等待耐压壳储备。五块锇锭与四块铁锭制造四块耐压壳。暂定完整方块质量4，耐压0.85；半砖质量减半，双半砖恢复完整质量。其他暴露船件仍按各自耐压判定，不形成整舰压力护盾。"
  ],
  "quest.1000000000080500.title": "制造气体采集口",
  "quest.1000000000080500.quest_desc": [
    "等待采集口。使用精密构件、两块高级电路、Create 储罐和旋转冷凝器制造，需先建立液氢工业。采集口与空的兼容储罐必须安装在同一艘 Sable 船体。"
  ],
  "quest.1000000000080600.title": "在 Amber 掠取氘",
  "quest.1000000000080600.quest_desc": [
    "接近 Amber，让采集口进入气压场，再从产出罐取一桶氘样本。重水电解已禁用，旋转转换只处理已有氘。压力0.5时参考产率10 mB/tick（待调初猜），普通方块从0.5损坏，锇耐压壳从0.85损坏（暂定）。桶检测不认证采集地点。"
  ],
  "quest.1000000000080700.title": "装满船载储罐",
  "quest.1000000000080700.quest_desc": [
    "手动飞行记录，非自动遥测：归还样本，将一个 Create 船载储罐装至8000 mB氘。核对实际液位后再勾选。另留返航燃料；整舰气压可能高于采集口气压。"
  ],
  "quest.1000000000080A00.title": "制作星际引擎",
  "quest.1000000000080A00.quest_desc": [
    "使用机械合成组装四块锇耐压壳、四块精英电路、一桶掠取的氘和一个宿主神经节（暂定）。将引擎与推进器、燃料罐安装在同一船体。离开母恒星系的推进需要星际引擎和氘；宿主遭遇构成引擎制造门槛。物品检测不认证安装。"
  ],
  "quest.1000000000080800.title": "离开母恒星系",
  "quest.1000000000080800.quest_desc": [
    "手动飞行记录：在同一船体安装星际引擎，携带氘离开母恒星系，核对边界外仍有推力后再勾选。体验行星都围绕母恒星运行。边界外推进需要星际引擎和氘，不禁止惯性滑行。冲量初值为柴油25倍，不声称一桶入轨已标定。引擎制造需要宿主神经节。"
  ]
}
