{
  "file.0000000000000001.title": "飞行任务记录",
  "chapter.1000000000000000.title": "0 · 落地",
  "quest.1000000000000100.title": "地表信号",
  "quest.1000000000000100.quest_desc": [
    "当前位于星球维度。体验预设从母星开始，未配发出生飞船。"
  ],
  "quest.1000000000000200.title": "木材储备",
  "quest.1000000000000200.quest_desc": [
    "手动确认：收集至少四根任意当地树种的原木后勾选。六个面构成连续星球。"
  ],
  "quest.1000000000000300.title": "野外工作台",
  "quest.1000000000000300.quest_desc": [
    "等待组装台面。使用本地木材制作工作台。"
  ],
  "quest.1000000000000400.title": "开始开采",
  "quest.1000000000000400.quest_desc": [
    "等待开采工具。石料与安山岩用于建设第一间工坊。"
  ],
  "quest.1000000000000500.title": "石料储备",
  "quest.1000000000000500.quest_desc": [
    "石料储备待补充。先在出生区域附近开采，再扩大活动范围。"
  ],
  "quest.1000000000000600.title": "作业照明",
  "quest.1000000000000600.quest_desc": [
    "等待照明补给。标记住所与矿井之间的路线。"
  ],
  "chapter.1000000000010000.title": "1 · 地面生存",
  "quest.1000000000010100.title": "冶炼站",
  "quest.1000000000010100.quest_desc": [
    "等待热加工设备。在工作台附近安装熔炉。"
  ],
  "quest.1000000000010200.title": "固体燃料",
  "quest.1000000000010200.quest_desc": [
    "手动确认：储备八份煤或木炭用于冶炼和照明后勾选。缺煤时可烧制原木取得木炭。"
  ],
  "quest.1000000000010300.title": "铁料补给",
  "quest.1000000000010300.quest_desc": [
    "等待铁料样本。母星矿表包含铁、铜、煤、金、锌、红石，不含锇。"
  ],
  "quest.1000000000010400.title": "稳定开采",
  "quest.1000000000010400.quest_desc": [
    "等待铁制工具。使用浅层铁铜制造采矿平台，再开采深层红石与金。"
  ],
  "quest.1000000000010500.title": "铜材导体",
  "quest.1000000000010500.quest_desc": [
    "等待铜材储备。流体设备与电气连接将使用这批材料。"
  ],
  "quest.1000000000010900.title": "建立采矿点",
  "quest.1000000000010900.quest_desc": [
    "使用四块铁锭、两块铜锭、铁镐、熔炉和拉杆合成。放在母星地表，加入熔炉燃料或 FE，先探矿再启动。平台逐层开挖 5×5、最深 512 格的矿井；围住井口并定期取走产物。完成的探矿结果以历史快照显示在 Atlas。物品任务不认证实际采出。"
  ],
  "quest.1000000000010600.title": "食物储备",
  "quest.1000000000010600.quest_desc": [
    "手动确认：储备至少八份合适食物，并建立可持续农田或畜牧来源后勾选；面包只是其中一种选择。"
  ],
  "quest.1000000000010700.title": "地表住所",
  "quest.1000000000010700.quest_desc": [
    "手动确认：建好照明住所与储物箱，放置任意颜色的床并设置安全重生点。在 Atlas 标记基地，离开后依靠航点返回，再勾选完成。"
  ],
  "quest.1000000000010800.title": "野外防护",
  "quest.1000000000010800.quest_desc": [
    "等待盾牌。整合包未设置氧气与航天服进度。"
  ],
  "chapter.1000000000020000.title": "2 · 机械动力",
  "quest.1000000000020D00.title": "深层供料与产物收纳",
  "quest.1000000000020D00.quest_desc": [
    "手动开采记录：使用采矿平台实际取得金与红石，不能只凭扫描结果勾选。按归一化地层深度找矿，不照搬原版 Y 值。记录选址、扫描、开挖耗时、燃料或 FE、手挖量与废石清理。为 18 格输出接入可用收纳，检查满库存与遇流体停止且不吞产物。保持区块加载与所有者在线，未提供离线采矿。"
  ],
  "quest.1000000000020100.title": "安山合金",
  "quest.1000000000020100.quest_desc": [
    "等待合金补给。母星保留浅层安山岩矿斑。"
  ],
  "quest.1000000000020200.title": "旋转动力源",
  "quest.1000000000020200.quest_desc": [
    "等待机械动力源。利用水流驱动水车。"
  ],
  "quest.1000000000020300.title": "动力传输",
  "quest.1000000000020300.quest_desc": [
    "等待传动轴储备。将水车接入工坊，检查应力余量。"
  ],
  "quest.1000000000020400.title": "冲压生产线",
  "quest.1000000000020400.quest_desc": [
    "等待冲压设备。船件与燃料设备需要金属板。"
  ],
  "quest.1000000000020500.title": "铁板储备",
  "quest.1000000000020500.quest_desc": [
    "等待铁板储备。使用机械压力机加工铁锭。"
  ],
  "quest.1000000000020600.title": "搅拌容器",
  "quest.1000000000020600.quest_desc": [
    "等待搅拌容器。预留搅拌器与热源的安装空间。"
  ],
  "quest.1000000000020700.title": "搅拌动力",
  "quest.1000000000020700.quest_desc": [
    "等待搅拌设备。投产前通过 JEI 核对所需转速。"
  ],
  "quest.1000000000020800.title": "热源储备",
  "quest.1000000000020800.quest_desc": [
    "下界已移除。使用三块铁板、一块煤炭块和一块铜锭合成烈焰人燃烧室。造炉煤块必须用煤，不能用木炭替代。自带烈焰人，放置后仍需普通燃料加热黄铜。"
  ],
  "quest.1000000000020900.title": "稳定热源",
  "quest.1000000000020900.quest_desc": [
    "将燃烧室放在工作盆下方并加燃料，达到加热搅拌所需热量；煤或木炭可供后续燃烧。暂定推进器配方还会消耗燃烧室，须另计生产备料。"
  ],
  "quest.1000000000020A00.title": "黄铜生产",
  "quest.1000000000020A00.quest_desc": [
    "等待黄铜储备。按配方加热混合铜与锌。"
  ],
  "quest.1000000000020B00.title": "控制电子元件",
  "quest.1000000000020B00.quest_desc": [
    "玻璃周围放置八份红石粉制作玫瑰石英，打磨后制造电子管。初始驾驶台、陀螺仪与导航观察镜使用 Create 部件，不要求外星锇。"
  ],
  "quest.1000000000020C00.title": "精密装配",
  "quest.1000000000020C00.quest_desc": [
    "保留序列装配：以金板起步，小齿轮、大齿轮与铁粒的装配序列重复五次。每次完整尝试须各备五份追加部件，并计入失败与副产物，不能预算为必得一个构件；建立可重复生产。"
  ],
  "quest.1000000000020F00.title": "机械合成设施",
  "quest.1000000000020F00.quest_desc": [
    "学习供后续大型配方使用的机械合成阵列。当前首船驾驶台、陀螺仪和推进器采用普通有序合成，机械阵列不是这些配方的要求。取得一个机械合成器不代表完整阵列、朝向、输出或应力达标；另计其传动预算。"
  ],
  "quest.1000000000020E00.title": "重复运行工坊",
  "quest.1000000000020E00.quest_desc": [
    "手动加工记录：实际运行动力冲压与加热搅拌，分批生产黄铜、电子管和成功的精密构件，并按当前普通有序配方实际制造驾驶台或陀螺仪。核对转速、应力、热源燃料、装配损耗与产物收纳。仅持有机器不能完成此记录。"
  ],
  "quest.1000000000021000.title": "首船材料与维修备料",
  "quest.1000000000021000.quest_desc": [
    "手动物料记录：按当前 JEI 列出工坊机器、传动、热源燃料、机械合成器、紧凑抽油机、蒸馏与管道等设施成本。另列每批投入、装配失败、船壳、组装器、胶、驾驶台、陀螺仪、推进器、导航镜、储罐、登船通道与维修备件，制造约定首船的零件储备。不预设固定船型或燃料预算；船体组装与试飞属于下一阶段。"
  ],
  "chapter.1000000000030000.title": "3 · 可选星球运输",
  "quest.1000000000030100.title": "规划小型旋翼运输艇",
  "quest.1000000000030100.quest_desc": [
    "可选手动规划记录：原 Immersive Aircraft 机身任务保留进度 ID，现迁移为 Create Aeronautics 教学。规划驾驶位、对称升力、货舱与可步行登乘路线，自行建造小艇；参考尺寸与载重尚未验收。步行勘探和地面工业无须飞机。"
  ],
  "quest.1000000000030200.title": "验证旋转动力",
  "quest.1000000000030200.quest_desc": [
    "可选手动记录：由原 Immersive Aircraft 发动机任务迁移。建立生存旋转动力与传动，记录转速、应力、消耗和续航。柴油或汽油不能直接让螺旋桨旋转。先验证原生控制；不承诺自动定高、辅助刹停或自动悬停。"
  ],
  "quest.1000000000030800.title": "地表勘察组件",
  "quest.1000000000030800.quest_desc": [
    "勘察推进组件已获取。观察面边界，远离不稳定折点。当前未提供折点自动检测任务。"
  ],
  "quest.1000000000030300.title": "布置升力与控制",
  "quest.1000000000030300.quest_desc": [
    "可选手动记录：由原 Immersive Aircraft 螺旋桨任务迁移。测试航空学螺旋桨旋向与推力方向、升力对称性及原生油门。陀螺螺旋桨轴承尝试保持螺旋桨朝上，不保证整艇平衡或悬停。通过 JEI 与模组指南核对部件。"
  ],
  "quest.1000000000030400.title": "空载试飞",
  "quest.1000000000030400.quest_desc": [
    "可选手动飞行记录：由原 Immersive Aircraft 双翼机任务迁移。使用生存动力验证离地、低速移动、转向、减速与着陆，再离艇并重新登艇。记录实际操作和能耗。此勾选不自动检测飞行，低空试飞不认证入轨船。"
  ],
  "quest.1000000000030900.title": "可选载货往返",
  "quest.1000000000030900.quest_desc": [
    "可选手动运输记录：使用生存动力在基地与矿区或油田之间运送一批有记录的矿物、补给或设备并往返。比较空载、对称满载与偏载，核对装卸、货物完整、离艇与再次登艇。另测跨面、地面和飞行中保存重进，记录能耗、操作、大气影响及未支持边界。未提供货运或飞行自动检测。"
  ],
  "quest.1000000000030500.title": "可选浮力设计",
  "quest.1000000000030500.quest_desc": [
    "可选自由建造分支：气囊仍可用于浮空艇，但小型旋翼运输艇不要求气球或跑道。此物品任务不认证飞行。"
  ],
  "chapter.1000000000040000.title": "4 · 燃料与入轨",
  "quest.1000000000040100.title": "油田勘探",
  "quest.1000000000040100.quest_desc": [
    "等待油田探测器。自定义星球生成器中的油田可用性仍需实测。"
  ],
  "quest.1000000000040200.title": "抽油动力",
  "quest.1000000000040200.quest_desc": [
    "可选 CDG 工程分支：轴承本身不能抽油，按 CDG 指南与 JEI 核对完整抽油结构、钻井与动力要求。此路线不阻塞 Starfold 紧凑抽油机、燃料生产或首船。"
  ],
  "quest.1000000000040D00.title": "紧凑抽油机",
  "quest.1000000000040D00.quest_desc": [
    "按当前 JEI 配方制作 Starfold Mining 抽油机。比较已发现的自然 CDG 油田，在正确星球与区块部署，使用设备勘探与受控建井、燃料或 FE 及流体输出。无须飞机或 CDG 大型抽油机轴承。物品任务不认证抽油；记录实际建井成本与耗时，不假定必须手铺数百格井管。"
  ],
  "quest.1000000000040E00.title": "泵、管道与原油储罐",
  "quest.1000000000040E00.quest_desc": [
    "备齐流体管道、带旋转动力的机械泵与独立原油及成品储罐，按 JEI 与指南核对泵向和连接。分开原油、柴油和汽油管路。先验证外罐输送，再依赖蒸馏塔；一个泵物品不认证管线已运行。"
  ],
  "quest.1000000000040F00.title": "自然原油进入外罐",
  "quest.1000000000040F00.quest_desc": [
    "手动抽油记录：勘探自然 CDG 油田、完成建井，再由紧凑抽油机向外部储罐输出真实原油。记录油田坐标、能源与耗时；CDG 油藏是区块储量，不是原油矿块。对照抽取、外罐装满及保存重进前后的储量与罐量，检查无丢失、复制或堵塞空耗。Atlas 发现是历史快照，不是实时余量表。保持所有者在线、区块加载。"
  ],
  "quest.1000000000040300.title": "燃料加工",
  "quest.1000000000040300.quest_desc": [
    "等待流体储罐与蒸馏控制器。将已放置的 Create 储罐转换为蒸馏塔；蒸馏罐方块没有独立背包物品。接入热源后生产第一级柴油或汽油。"
  ],
  "quest.1000000000040400.title": "首批柴油或汽油",
  "quest.1000000000040400.quest_desc": [
    "手动生产记录：将自然抽出的原油蒸馏为柴油或汽油，核对实际成品罐。任意一种即可完成，无须同时提交两种；此处未配置可靠的自动 OR 检测。记录产量、耗时、热量和能耗。旧八桶入轨估计未经验证，飞行储备留待试船标定。"
  ],
  "quest.1000000000041000.title": "再次补充成品燃料",
  "quest.1000000000041000.quest_desc": [
    "手动生产记录：首批之后，再从自然原油抽取并蒸馏第二批柴油或汽油，任意一种即可。分开记录两批的原油投入、成品产量、耗时、能耗、热源燃料与维护。无指令补料或注入原油，证明工厂可以再次补充储罐；记录产能，不用固定入轨桶数验收。"
  ],
  "quest.1000000000030600.title": "物理结构组装",
  "quest.1000000000030600.quest_desc": [
    "等待物理结构组装器。建造入轨船体前确认安装方向与组装操作。"
  ],
  "quest.1000000000030700.title": "结构连接",
  "quest.1000000000030700.quest_desc": [
    "等待强力胶。连接预定船体方块，避免将起飞平台粘入结构。"
  ],
  "quest.1000000000040500.title": "船载储罐",
  "quest.1000000000040500.quest_desc": [
    "等待流体储罐。储罐与推进器必须属于同一组装船体，保留返航燃料。"
  ],
  "quest.1000000000040600.title": "推力设备",
  "quest.1000000000040600.quest_desc": [
    "一个推进器物品只检测零件。成对布置升降、前后和侧向喷口，喷口朝向与推力相反。本包需要同船兼容储罐内的柴油或汽油；燃料计入质量，比较升力与加油后船重并保留刹停余量。"
  ],
  "quest.1000000000040700.title": "姿态控制",
  "quest.1000000000040700.quest_desc": [
    "安装陀螺仪并通电：参考布置使用两个，每个各装一个拉杆并打开。陀螺仪本身不耗推进燃料，但悬停会调用真实升力喷口，离地保持高度仍会耗油。陀螺仪不能代替推力平衡或足够升力。"
  ],
  "quest.1000000000040800.title": "驾驶控制台",
  "quest.1000000000040800.quest_desc": [
    "驾驶台已获取。起飞前检查船体连接、离地间隙与反向推进。"
  ],
  "quest.1000000000040900.title": "目视仪表",
  "quest.1000000000040900.quest_desc": [
    "基础观察镜已获取。首航前使用精密构件、电子管与两块黄铜板升级为导航观察镜。"
  ],
  "quest.1000000000050800.title": "导航光学",
  "quest.1000000000050800.quest_desc": [
    "导航观察镜通过 Create 路线制造，无须锇。首次起飞前检查目标锁定与相对接近速度。"
  ],
  "quest.1000000000040C00.title": "登船路线",
  "quest.1000000000040C00.quest_desc": [
    "登船梯已获取。在母星演练着陆与登船。现有母星返航进度记录后续外星返航的玩家着陆历史，不认证本次演练或同船运输。"
  ],
  "quest.1000000000041100.title": "起飞前组装与验船",
  "quest.1000000000041100.quest_desc": [
    "手动地面检查：用胶与组装器组装预定船体，排除起飞平台。将驾驶台、通电陀螺仪、推进器、导航镜与兼容燃料罐装在同船体，打开陀螺仪拉杆、关闭推进器手动红石。测试供油、反向推进和间隙；舱门下朝外安装登船梯，停稳等梯展开，沿梯上船后右键驾驶台。接管后保持停稳，确认起飞点记录再起飞。首次离开母星前用导航镜核对目标锁定与相对接近速度。记录干重、加油质量与返航余量，实际试飞再定燃料预算。此勾选不自动检测安装。",
    "可选 B6-F 参考：185格船体，供给4000mB柴油的独立夹具短飞已通过，未验从零生存及载荷。甲板Y=0，船首向西（-X）；每行五格从X=-2到+2，各行从Z=-2到+2。",
    "Y=-6,-5,-4,-2,-1：CCCCC / CCCCC / CCCCC / CCCCC / CCCCC",
    "Y=-3：TnCnT / wCCCe / BCCCB / wCCCe / TsCsT",
    "Y=0：PPAPP / PPvPP / P^P^P / PPvPP / PPAPP",
    "Y=1：..d.. / ..... / G.H.G / ..... / ..d..",
    "Y=2：..d.. / ..... / l.N.l / ..... / ..d..",
    "C圆石，P橡木板，T流体储罐，B朝外货桶；n/s/w/e/^/v分别为朝北/南/西/东/上/下排气的喷口，推力相反。A朝外登船梯，d打开的门上下半部，G陀螺仪，l已打开拉杆，H朝西驾驶台，N朝西导航镜。点号是空气；两侧登船路线保持净空。",
    "船体物品：136圆石、19木板、12推进器、2陀螺仪、2拉杆、1驾驶台、1导航镜、2登船梯、2门物品、4储罐、2货桶。胶、组装器、工具、燃料和备件另备；组装后挖回被捕获的组装器。门正常一批制作会多余一扇。",
    "岸侧维护平台留在胶框外；推进燃料须在同船可抽取罐中。四罐全满可能超重，先测干重/湿重与升力余量；悬停仍耗油。初始等量不保证放油始终平衡；旧B6操纵数据不认证这艘改船。"
  ],
  "quest.1000000000040A00.title": "离地记录",
  "quest.1000000000040A00.quest_desc": [
    "等待离地进度记录。先完成可控爬升，再继续入轨。"
  ],
  "quest.1000000000041200.title": "母星着陆、再登船与维修",
  "quest.1000000000041200.quest_desc": [
    "手动母星试飞记录：离地后在起飞点附近完成短程低空移动、转向与刹停，着陆停稳后再退出驾驶。沿展开的登船梯步行离船、再次登船并恢复驾驶。停泊时演练更换一块非关键船壳，恢复连接并重新验船。记录前后燃料、载荷、操作与损伤，保留着陆余量。离地进度不认证这些动作，勾选也不自动检测。B6-F 仅为参考布置提案，不保证加油后的实测性能；进入太空和外星采矿分别留待后续。"
  ],
  "quest.1000000000050C00.title": "登记首次采矿往返",
  "quest.1000000000050C00.quest_desc": [
    "手动出发记录，非自动遥测：在 Atlas 比较母星卫星 Fleck 与岩质星 Anvil，按当前距离、接近速度及实际探矿选择，不固定星球编号。两者在母恒星系内，无须星际引擎。登记船体UUID、基地标记、目标、货物基线、各罐液位和独立着陆储备。按去程与返程起飞、转移、制动逐段预算；近地短飞123mB不代表往返预算。带铁镐、Ultimine、食物、照明和维修工具。出发前标记基地并演练找回停泊船。勾选不自动检测准备情况。"
  ],
  "quest.1000000000040B00.title": "太空区域记录",
  "quest.1000000000040B00.quest_desc": [
    "等待进入太空的进度记录。完成后状态：当前位于太空区域。保持驾驶，监测燃料。"
  ],
  "chapter.1000000000050000.title": "5 · 第一次跨星：锇",
  "quest.1000000000050100.title": "外星着陆",
  "quest.1000000000050100.quest_desc": [
    "等待外星着陆进度记录。岩质星球与小行星提供锇及深层稀有钻石；钻石位于可挖深度底部35%，丰度为待调初猜。这些星球仍在当前恒星系内。"
  ],
  "quest.1000000000050200.title": "锇矿货物",
  "quest.1000000000050200.quest_desc": [
    "8份原锇为启动货物门槛，不证明开采或运输；登记母星卸货前保留原矿。更大工业升级仍需另备锇。"
  ],
  "quest.1000000000050D00.title": "装矿与返程复核",
  "quest.1000000000050D00.quest_desc": [
    "手动装矿记录，非自动货物追踪：在所选星球用铁镐及 Ultimine 采至少8份原锇，保留安全出口。装入登记船体，记录原矿数量、船体UUID与各罐液位，按当前质量重新核对返程升力与燃料。持有物品不证明采集地点或船运。离船前登记着陆点，安全停泊后停止浪费推进燃料。返航油不足时停泊，安排送油或救援船；不保证当地能产油。"
  ],
  "quest.1000000000050400.title": "母星着陆记录",
  "quest.1000000000050400.quest_desc": [
    "等待玩家返航着陆历史：外星着陆并再次入太空后返回母星。该进度不核对同船或运回货物，另完成卸矿记录。"
  ],
  "quest.1000000000050E00.title": "同船卸矿核对",
  "quest.1000000000050E00.quest_desc": [
    "手动交付记录，非自动同船认证：母星着陆后核对出发、装矿和抵达的船体UUID，将至少8份原锇卸入基地仓库，对齐数量与各罐液位。登记卸货前保持原矿，之后再冶炼。母星返航进度按玩家历史推进，不证明船体身份或货物来源。离线航程日志工具只核对所填观察的一致性，保留截图或服务器回执。缺失航段或更换船体不能写成同船往返。"
  ],
  "quest.1000000000050300.title": "精炼锇材",
  "quest.1000000000050300.quest_desc": [
    "等待锇锭。取得外星供料后启动 Mekanism 工业线。"
  ],
  "quest.1000000000050500.title": "机械能转电能",
  "quest.1000000000050500.quest_desc": [
    "可选旋转供电路线：将 Create 动力接入电气线。也可用热力发电机直接启动灌注机，本分支不阻塞电路加工。"
  ],
  "quest.1000000000050600.title": "电路加工",
  "quest.1000000000050600.quest_desc": [
    "等待冶金灌注机。可用热力发电机启动，或选用 Create 交流发电机路线。热力发电机、灌注机和两块基础电路合计消耗4锇锭，不含运行燃料。接入电力并提供灌注材料。"
  ],
  "quest.1000000000050700.title": "基础控制电路",
  "quest.1000000000050700.quest_desc": [
    "等待基础控制电路。锇用于启动 Mekanism 加工，并进一步制作精密观察镜所需的高级电路。"
  ],
  "quest.1000000000050900.title": "氢气生产",
  "quest.1000000000050900.quest_desc": [
    "等待电解分离器。供应水与电力；化学形态氢不能直接作为推进器流体。"
  ],
  "quest.1000000000050A00.title": "流体转换",
  "quest.1000000000050A00.quest_desc": [
    "等待旋转冷凝器。先将氢转为流体形态，再向船载储罐加注。"
  ],
  "quest.1000000000050B00.title": "第二级燃料样本",
  "quest.1000000000050B00.quest_desc": [
    "等待液氢样本。当前每mB冲量为柴油两倍，配置燃料质量相同。持有一桶不认证生产线或入轨预算，另登记实际生产核对。"
  ],
  "quest.1000000000050F00.title": "重复供应液氢",
  "quest.1000000000050F00.quest_desc": [
    "手动生产记录，非自动遥测：向电解分离器供水与持续电力，将化学氢送入冷凝模式的旋转冷凝器，再将流体氢输送至兼容船载储罐。处理不用的氧气输出，避免堵塞。记录两次分别收取的批次、输入产出量、电源、端口、模式与液位；核对抽取支持。一桶样本不证明此生产链。按实际质量和重力预算起飞返航，不承诺固定桶数。"
  ],
  "quest.1000000000051000.title": "S-01 探索艇蓝图",
  "quest.1000000000051000.quest_desc": [
    "将空白蓝图放入蓝图桌，选择整合包自带的 s01.nbt。在空旷船坞预览，保持船头朝西，再按蓝图炮给出的清单供应材料和火药。保留已有实心方块，关闭跳过缺料，让蓝图炮停工等补货。打印后检查两台陀螺仪。如未通电，重新放置紧邻的红石块。用胶和物理组装器组装船体，船坞留在地面。给普通储罐加油，先完成近地试飞再载货。"
  ],
  "chapter.1000000000060000.title": "6 · 星系扩张",
  "quest.1000000000060B00.title": "制作铝合金外壳板",
  "quest.1000000000060B00.quest_desc": [
    "等待轻质面板。采集沙漠类星球的铝土矿，冶炼后使用八块铝锭制造四块板材。完整方块质量0.5，默认耐压0.5，数值暂定。"
  ],
  "quest.1000000000060400.title": "高级控制电路",
  "quest.1000000000060400.quest_desc": [
    "等待高级控制电路。为精密光学准备电子元件。"
  ],
  "quest.1000000000060500.title": "精密光学",
  "quest.1000000000060500.quest_desc": [
    "精密观察镜已获取。该配方升级光学设备。离开母恒星系需要星际引擎和氘；引擎配方需要宿主神经节，不另设驾驶员 boss 许可标记。"
  ],
  "quest.1000000000060C00.title": "核对运输船升级",
  "quest.1000000000060C00.quest_desc": [
    "手动工程记录，非飞行认证：比较同一布局以铝轻质板替换圆石压舱前后，登记实际干质量、货物、燃料种类与体积、有效重力及升力喷口，核对湿质量、升力余量和理想Δv。保持通行与喷口方向。液氢每mB冲量为柴油两倍，燃料质量并不减半。货物质量须实测或明确建模。减重不认证操纵、续航或耐压；完整轻质板默认耐压仍为0.5。"
  ],
  "quest.1000000000060D00.title": "重复有补给的资源路线",
  "quest.1000000000060D00.quest_desc": [
    "手动路线记录，非自动运输认证：按需求选择一条资源路线，登记两次完成交付的船体UUID、原矿数量、液位与出发抵达观察。标记前哨，储备食物、照明、工具、备用船壳与兼容燃料，离家前安排救援供油。对齐生产、装货和基地卸货；储备不足就停泊。可选资源物品任务不证明旅行，无须遍访星球或建设反应堆，主线不依赖随机结构战利品。"
  ],
  "quest.1000000000060100.title": "冰冻星锡矿",
  "quest.1000000000060100.quest_desc": [
    "等待锡矿货物。冰冻类星球矿表提供锡与铅。"
  ],
  "quest.1000000000060200.title": "冰冻星铅矿",
  "quest.1000000000060200.quest_desc": [
    "等待铅矿货物。建立运输路线，避免只依赖单次小规模采集。"
  ],
  "quest.1000000000060300.title": "晶体星萤石",
  "quest.1000000000060300.quest_desc": [
    "等待萤石样本。晶体类星球还提供石英、紫水晶及更少量深层钻石（可挖深度底部35%，丰度为待调初猜）。"
  ],
  "quest.1000000000060600.title": "干旱星铀矿",
  "quest.1000000000060600.quest_desc": [
    "等待铀矿货物。干旱类星球矿表提供铀与金；建设反应堆前规划屏蔽与加工。"
  ],
  "quest.1000000000060700.title": "火山星残骸",
  "quest.1000000000060700.quest_desc": [
    "等待远古残骸。火山类星球矿表包含残骸、金与石英；开采时避开岩浆。"
  ],
  "quest.1000000000060800.title": "耐热材料储备",
  "quest.1000000000060800.quest_desc": [
    "等待下界合金碎片。该材料不构成抗压船体认证。"
  ],
  "quest.1000000000060900.title": "流体货运能力",
  "quest.1000000000060900.quest_desc": [
    "等待高级流体储罐。核对 Mekanism 储罐与船载储罐之间的流体输送。"
  ],
  "quest.1000000000060A00.title": "前哨维护",
  "quest.1000000000060A00.quest_desc": [
    "钢制多用工具已获取。为已建立的前哨补充工具与维修材料。"
  ],
  "quest.1000000000060E00.title": "规划 C-07 母舰船坞",
  "quest.1000000000060E00.quest_desc": [
    "在蓝图桌选择 c07-hull-1.nbt 至 c07-hull-4.nbt。保持船头朝西，以同一船坞原点定位。四段的 X Y Z 偏移分别为 (0 7 5)、(40 1 6)、(72 1 0)、(92 6 3)。可单炮逐段施工，也可四炮各打一段。左右舱门用独立蓝图，偏移分别为 (42 0 20) 和 (42 0 10)。给舱门留出摆动净空，保持施工区块加载。服务器重启后检查每门炮，显示就绪时按开始继续。两扇舱门和小艇都要与母舰分开组装。"
  ],
  "chapter.1000000000070000.title": "7 · 异常星球与 boss",
  "quest.1000000000070100.title": "战斗防护",
  "quest.1000000000070100.quest_desc": [
    "等待护甲。接近异常地形前确认安全撤离路线。"
  ],
  "quest.1000000000070200.title": "远程作战能力",
  "quest.1000000000070200.quest_desc": [
    "等待远程武器。战斗时远离不稳定折点地形。"
  ],
  "quest.1000000000070300.title": "弹药储备",
  "quest.1000000000070300.quest_desc": [
    "等待弹药补给。补给数量为待实测调整的初值。"
  ],
  "quest.1000000000070400.title": "恢复补给",
  "quest.1000000000070400.quest_desc": [
    "等待恢复补给。血肉勘测需要补给，以及通往巢穴巨坑外的撤离路线。"
  ],
  "quest.1000000000070800.title": "抵达血肉",
  "quest.1000000000070800.quest_desc": [
    "手动勘测记录：定位 Amber 最外侧卫星血肉，确认着陆后登记。勾选不自动检测所在星球。"
  ],
  "quest.1000000000070900.title": "进入巢穴巨坑",
  "quest.1000000000070900.quest_desc": [
    "手动勘测记录：沿巢脊进入巨坑后登记。接近宿主前记录撤离路线。勾选不自动检测进入。"
  ],
  "quest.1000000000070A00.title": "击败宿主",
  "quest.1000000000070A00.quest_desc": [
    "等待战斗记录：在巢穴巨坑击败宿主。每颗有巢穴的星球各自记录一次遭遇，击败后经过七个游戏日会再次出现。战利品表掉落四个宿主神经节，为机械线星际引擎提供必需的生物部件；及时拾取并妥善保管。"
  ],
  "quest.1000000000070B00.title": "获得宿主神经节",
  "quest.1000000000070B00.quest_desc": [
    "等待神经节样本。保留一个用于机械合成星际引擎，其余样本可供后续引擎制造。用量暂定。"
  ],
  "chapter.1000000000080000.title": "8 · 气态巨行星与星际航行",
  "quest.1000000000080100.title": "船体材料储备",
  "quest.1000000000080100.quest_desc": [
    "等待船载设备钢材。耐压值按方块计算，不是整舰护盾。"
  ],
  "quest.1000000000080200.title": "结构材料储备",
  "quest.1000000000080200.quest_desc": [
    "等待结构材料补给。普通铁块仍从压力0.5开始损坏；深层采集前将暴露结构换为耐压壳。"
  ],
  "quest.1000000000080300.title": "远程控制组件",
  "quest.1000000000080300.quest_desc": [
    "等待精英控制电路。掠取氘后，为星际引擎预留四块精英电路。"
  ],
  "quest.1000000000080400.title": "大容量储存",
  "quest.1000000000080400.quest_desc": [
    "等待储存设备。依赖该储罐飞行前，验证船载燃料抽取支持情况。"
  ],
  "quest.1000000000080900.title": "制作锇合金耐压壳",
  "quest.1000000000080900.quest_desc": [
    "采气前等待耐压壳储备。五块锇锭与四块铁锭制造四块耐压壳。暂定完整方块质量4，耐压0.85；半砖质量减半，双半砖恢复完整质量。其他暴露船件仍按各自耐压判定，不形成整舰压力护盾。"
  ],
  "quest.1000000000080500.title": "制造气体采集口",
  "quest.1000000000080500.quest_desc": [
    "等待采集口。使用精密构件、两块高级电路、Create 储罐和旋转冷凝器制造，需先建立液氢工业。采集口与空的兼容储罐必须安装在同一艘 Sable 船体。"
  ],
  "quest.1000000000080600.title": "在 Amber 掠取氘",
  "quest.1000000000080600.quest_desc": [
    "接近 Amber，让采集口进入气压场，再将已采流体经管道与有动力机械泵送入 Create 注液器，在其下置物台或传送带放空桶，灌装1000mB氘样本。普通 Create 储罐不能靠生存右键装桶。重水电解已禁用，旋转转换只处理已有氘。压力0.5时参考产率10 mB/tick（待调初猜），普通方块从0.5损坏，锇耐压壳从0.85损坏（暂定）。桶检测不认证采集地点。"
  ],
  "quest.1000000000080700.title": "装满船载储罐",
  "quest.1000000000080700.quest_desc": [
    "手动飞行记录，非自动遥测：归还样本，将一个 Create 船载储罐装至8000 mB氘。核对实际液位后再勾选。另留返航燃料；整舰气压可能高于采集口气压。"
  ],
  "quest.1000000000080B00.title": "撤离并重复采气",
  "quest.1000000000080B00.quest_desc": [
    "手动采气飞行记录，非自动遥测：入场与安全撤离后登记采集口压力、船体最高暴露压力、液位、损伤与推进储备，再单独记录第二批并再次撤离。耐压壳不保护采集口、控制件或储罐，须在最弱部件阈值前撤退。8000mB满罐只证明储存，不是远征预算；另留制造用氘桶及飞行燃料。"
  ],
  "quest.1000000000080A00.title": "制作星际引擎",
  "quest.1000000000080A00.quest_desc": [
    "使用机械合成组装四块锇耐压壳、四块精英电路、一桶掠取的氘和一个宿主神经节（暂定）。将引擎与推进器、燃料罐安装在同一船体。离开母恒星系的推进需要星际引擎和氘；宿主遭遇构成引擎制造门槛。物品检测不认证安装。"
  ],
  "quest.1000000000080C00.title": "核对同船星际引擎",
  "quest.1000000000080C00.quest_desc": [
    "手动安装记录，非自动检测：将自制引擎装在推进器与可抽取氘罐所属的同一组装船体，登记船体UUID、连接、干湿质量、燃料与反推。物品任务只证明持有。可另带母星系作业用普通燃料，但它增加质量且不能提供母星系外推力；惯性滑行不需引擎或燃料，制动需要。"
  ],
  "quest.1000000000080D00.title": "登记远征目的地与返航储备",
  "quest.1000000000080D00.quest_desc": [
    "手动远征计划，非航线认证：在 Atlas 选择另一恒星和实际着陆候选，登记星系/星球标识、当前距离与接近速度、基地标记、船体UUID、货物和各燃料罐。按去程加速、目标相对制动、着陆、返程起飞及制动逐段预算，保留不动用储备。离线工具须显式标注母星系外航段，只核对声明的燃料/引擎资格。带食物、照明、工具、维修件并安排送达救援燃料，不承诺固定桶数或航时。"
  ],
  "quest.1000000000080800.title": "离开母恒星系",
  "quest.1000000000080800.quest_desc": [
    "手动飞行记录：在同一船体安装星际引擎，携带氘离开母恒星系，核对边界外仍有推力后再勾选。具名起步行星围绕母恒星运行，体验宇宙另有其他星系；出发前在 Atlas 选择实际目的地。边界外推进需要星际引擎和氘，不禁止惯性滑行。冲量初值为柴油25倍，不声称一桶入轨已标定。引擎制造需要宿主神经节。"
  ],
  "quest.1000000000080E00.title": "在另一星系着陆",
  "quest.1000000000080E00.quest_desc": [
    "手动抵达记录，非自动目的地或同船检测：确认所选世界属于另一星系，按相对运动减速并安全着陆。核对出发抵达船体UUID、货物、燃料及损伤；仅越过边界不算抵达。保留地图观察、截图或服务器回执，玩家着陆进度不证明星系身份或货物来源。"
  ],
  "quest.1000000000080F00.title": "补给远征据点并重进",
  "quest.1000000000080F00.quest_desc": [
    "手动据点记录，非自动建造检测：标记着陆点，建立照明住所与仓库，储备食物、工具、维修件及送达的兼容燃料。选一种有用当地资源或建设目标并记录真实货运。保存退出再重进，核对同船、货物、液位、标记与据点可用性。返程油不足就停泊；其他星系不保证独占矿或当地氘生产，不默认据点能自行供油。"
  ],
  "quest.1000000000081000.title": "返航并恢复远征路线",
  "quest.1000000000081000.quest_desc": [
    "手动远征收尾，非自动运输认证：用登记船体返回标记基地，对齐卸货、液位和维修，再为下一次出发补充据点运输物资。换船、救援或补油须明确登记，不冒充无中断同船航程；保留双向证据。此项完成首次远征目标，之后仍可开放探索；不要求反应堆、随机结构战利品或遍访全部世界。"
  ]
}
